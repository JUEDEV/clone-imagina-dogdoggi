# Dominio de producción (build): canonical, sitemap y robots.
PUBLIC_SITE_URL=https://dogdoggi.com

# --- Strata (ecommerce). Solo servidor, se leen al ejecutarse (Dokploy). ---
# Sin CMS_BASE_URL el sitio usa el catálogo de muestra y, en desarrollo, guarda
# los pedidos en .data/orders.json. En producción sin Strata no se reciben pedidos.
CMS_BASE_URL=            # https://<admin>/api
CMS_STATIC_TOKEN=

# --- Wompi. Sin llaves: pago simulado en desarrollo, checkout deshabilitado en producción. ---
WOMPI_PUBLIC_KEY=        # pub_test_… / pub_prod_…
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_KEY=        # webhook: https://<dominio>/api/payments/wompi/webhook
WOMPI_PRIVATE_KEY=       # consulta por referencia cuando el cliente no vuelve
WOMPI_URL=               # opcional; se deduce de la llave pública

# --- Correo del formulario de contacto (SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=               # Nombre correo@dominio (mismo correo que SMTP_USER)
CONTACT_NOTIFY_TO=       # opcional; por defecto la casilla de SMTP_FROM
