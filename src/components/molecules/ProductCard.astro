---
import Icon from '@/components/atoms/Icon.astro'
import { discountOf, money, type Product } from '@/data/products'
import { cn } from '@/lib/utils'

// Tarjeta de producto. Variantes según la vitrina:
// - default: la del slider de destacados.
// - feature: horizontal en escritorio ancho (vitrina Perfect Groom), compacta en móvil.
// - compact: compacta en móvil (rejilla de ofertas de dos columnas).
// TODO: favoritos y carrito quedan sin lógica hasta conectar el ecommerce (CMS).
interface Props {
  product: Product
  variant?: 'default' | 'feature' | 'compact'
  class?: string
}

const { product, variant = 'default', class: className } = Astro.props
const discount = discountOf(product)
const tagClass =
  product.tag === 'Oferta' ? 'bg-yellow text-navy' : product.tag === 'Nuevo' ? 'bg-turquoise text-navy' : 'bg-[#dff3fc] text-[#006594]'
const feature = variant === 'feature'
const small = variant !== 'default'
const imageHeights = {
  default: 'h-[240px] md:h-[265px]',
  feature: 'h-[160px] md:h-[200px] desk:h-full',
  compact: 'h-[165px] md:h-[265px]',
}
---

<article
  data-kind={product.kind}
  class={cn(
    'group/card relative min-w-0 overflow-hidden rounded-[18px] border border-line bg-paper text-navy transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_14px_32px_rgba(5,28,72,0.1)]',
    feature && 'desk:grid desk:min-h-[245px] desk:grid-cols-[44%_1fr]',
    className,
  )}
>
  <div class:list={['relative overflow-hidden bg-surface', imageHeights[variant]]}>
    {product.tag && (
      <span class={cn('absolute top-3 left-3 z-[2] max-w-[100px] rounded-md px-[9px] py-1 text-[10px] font-extrabold md:max-w-none', tagClass)}>
        {product.tag}
      </span>
    )}
    {discount > 0 && (
      <span class="absolute top-[42px] left-3 z-[2] rounded-md bg-orange px-[9px] py-1 text-[10px] font-extrabold text-white">
        −{discount}%
      </span>
    )}
    <button
      type="button"
      class="absolute top-[9px] right-[9px] z-[3] grid size-11 place-items-center rounded-full bg-white/90 text-navy"
      aria-label={`Agregar ${product.name} a favoritos`}
    >
      <Icon name="heart" class="size-[19px]" />
    </button>
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      class="h-full w-full object-contain mix-blend-multiply transition-transform duration-300 ease-out group-hover/card:scale-105"
    />
  </div>
  <div class:list={[small ? 'p-[13px] md:p-[18px]' : 'p-[18px]', feature && 'desk:p-5']}>
    <p class="mb-1 text-[10px] font-extrabold tracking-[0.08em] text-ink-soft uppercase">{product.category}</p>
    <h3
      class:list={[
        'mb-[13px] min-h-11 leading-[1.25] font-medium',
        small ? 'text-[15px] md:text-lg' : 'text-[15px] xs:text-lg',
        feature && 'desk:text-[17px]',
      ]}
    >
      {product.name}
    </h3>
    <div class="mb-3.5 flex flex-wrap items-baseline gap-2">
      <strong class:list={['font-extrabold', small ? 'text-base md:text-xl' : 'text-xl']}>{money(product.price)}</strong>
      {product.oldPrice && <del class="text-[13px] text-[#68758a]">{money(product.oldPrice)}</del>}
    </div>
    <button
      type="button"
      class:list={[
        'flex min-h-11 w-full items-center justify-center gap-2 rounded-[10px] border-[1.5px] border-orange px-2 font-extrabold text-[#b83f00] transition-colors duration-200 hover:bg-orange hover:text-white',
        small ? 'text-[11px] md:text-[13px]' : 'text-[13px]',
        feature && 'desk:text-xs',
      ]}
    >
      <Icon name="shopping-bag" class="size-[17px]" />
      Agregar al carrito
    </button>
  </div>
</article>
