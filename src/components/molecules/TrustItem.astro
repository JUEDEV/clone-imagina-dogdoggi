---
import Icon from '@/components/atoms/Icon.astro'
import type { TrustItem } from '@/data/home'

// Ítem de la franja de confianza (envíos, pago seguro…).
interface Props {
  item: TrustItem
}

const { item } = Astro.props
---

<div
  class="flex items-center justify-start gap-[13px] px-2.5 py-4 md:justify-center md:border-r md:border-navy/20 md:px-6 md:py-2 md:last:border-0"
>
  <Icon name={item.icon} class="size-[25px] shrink-0 md:size-[30px]" />
  <div>
    <strong class="block text-xs md:text-sm">{item.title}</strong>
    <span class="block text-[10px] leading-[1.35] text-[#082f46] md:text-[11px]">{item.text}</span>
  </div>
</div>
