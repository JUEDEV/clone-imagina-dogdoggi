---
import Icon from '@/components/atoms/Icon.astro'
import type { Category } from '@/data/home'

// Tarjeta de categoría. El fondo rota entre tres tonos (lo decide la rejilla con nth-child).
interface Props {
  category: Category
}

const { category } = Astro.props
---

<a
  href={category.href}
  class="group/cat relative isolate min-h-[168px] overflow-hidden rounded-[15px] bg-[#edf7f8] p-3.5 text-left xs:min-h-[175px] xs:p-[17px] md:min-h-[210px] md:rounded-[20px] md:p-6 [&:nth-child(3n)]:bg-[#edf2fa] [&:nth-child(3n+2)]:bg-[#fff2e9]"
>
  <div class="relative z-[2] max-w-[82%] md:max-w-[67%]">
    <h3 class="mb-2 text-[17px] leading-[1.15] font-semibold md:text-xl">{category.name}</h3>
    <span class="block text-[11px] leading-[1.3] text-[#384b64] md:text-[13px]">{category.note}</span>
    <i class="mt-[17px] grid size-8 place-items-center rounded-full bg-paper md:mt-[25px] md:size-[35px]">
      <Icon name="arrow-up-right" class="size-[18px]" />
    </i>
  </div>
  <img
    src={category.image}
    alt=""
    loading="lazy"
    class:list={[
      'absolute -z-[1] transition-transform duration-[250ms] ease-out group-hover/cat:scale-[1.06] group-hover/cat:-rotate-2',
      category.photo
        ? 'right-0 bottom-0 h-full w-[58%] object-cover opacity-70 [mask-image:linear-gradient(to_left,black_55%,transparent)]'
        : '-right-3 -bottom-3 h-[62%] w-[62%] object-contain mix-blend-multiply md:h-3/4 md:w-[55%]',
    ]}
  />
</a>
