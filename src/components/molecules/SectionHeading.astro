---
import Icon from '@/components/atoms/Icon.astro'

// Encabezado de sección: titular (slot) + bajada opcional + enlace de acción a la derecha.
interface Props {
  text?: string
  action?: { label: string; href: string }
  class?: string
}

const { text, action, class: className } = Astro.props
---

<div class:list={['mb-[26px] flex items-start justify-between gap-[30px] md:mb-9 md:items-end', className]}>
  <div>
    <h2 class="mb-[7px] text-[32px] leading-[1.1] font-semibold tracking-[-0.02em] md:text-[clamp(32px,3vw,44px)]">
      <slot />
    </h2>
    {text && <p class="m-0 text-[15px] leading-normal text-ink-soft md:text-[17px]">{text}</p>}
  </div>
  {action && (
    <a
      href={action.href}
      class="hidden min-h-11 items-center gap-[7px] py-1.5 font-extrabold whitespace-nowrap transition-colors hover:text-orange-dark md:inline-flex"
    >
      {action.label}
      <Icon name="arrow-up-right" class="size-[18px]" />
    </a>
  )}
</div>
