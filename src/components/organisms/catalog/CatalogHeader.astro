---
import Breadcrumb from '@/components/molecules/Breadcrumb.astro'
import type { Crumb } from '@/lib/seo'

// Encabezado compacto de listados (catálogo, categoría): ruta, titular y bajada.
// Más bajo que PageHero para que los productos aparezcan pronto.
interface Props {
  crumbs: Crumb[]
  title: string
  description?: string
}

const { crumbs, title, description } = Astro.props
---

<section class="border-b border-[#d2edeb] bg-[#e7f8f7] pt-5 pb-8 md:pt-7 md:pb-10">
  <div class="shell">
    <Breadcrumb items={crumbs} />
    <h1 class="text-[38px] leading-[1.05] font-semibold tracking-[-0.03em] md:text-[clamp(40px,4vw,56px)]">{title}</h1>
    {description && <p class="mt-3 max-w-[680px] text-base leading-relaxed text-[#233a59] md:text-lg">{description}</p>}
  </div>
</section>
