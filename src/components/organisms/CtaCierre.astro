---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Icon from '@/components/atoms/Icon.astro'
import Reveal from '@/components/atoms/Reveal.astro'
import { WHATSAPP_URL } from '@/data/site'

// Cierre de las páginas internas: invitación a pedir asesoría o volver a la tienda.
interface Props {
  title?: string
  text?: string
}

const {
  title = '¿Buscas algo puntual?',
  text = 'Te ayudamos a encontrar la herramienta o el producto ideal para tu peluquería.',
} = Astro.props
---

<section class="bg-navy py-16 text-white md:py-20">
  <Reveal class="shell flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <div>
      <h2 class="mb-3 text-[32px] leading-[1.1] font-semibold md:text-[clamp(32px,3vw,44px)]">{title}</h2>
      <p class="max-w-[520px] text-[#c7d4e6]">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <ButtonLink href={WHATSAPP_URL} external>
        <Icon name="whatsapp" class="size-5" />
        Pregúntanos
      </ButtonLink>
      <ButtonLink href="/#destacados" variant="outline-light">
        Ir a la tienda
        <Icon name="arrow-right" class="size-[18px]" />
      </ButtonLink>
    </div>
  </Reveal>
</section>
