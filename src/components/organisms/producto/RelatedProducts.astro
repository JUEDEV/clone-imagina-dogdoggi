---
import Reveal from '@/components/atoms/Reveal.astro'
import ProductCard from '@/components/molecules/ProductCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { cardContext, relatedProducts, type Catalog, type Product } from '@/lib/catalog'

// Productos de la misma categoría o marca, debajo de la ficha.
interface Props {
  catalog: Catalog
  product: Product
}

const { catalog, product } = Astro.props
const related = relatedProducts(catalog, product)
---

{related.length > 0 && (
  <section class="bg-mint py-14 md:py-20">
    <div class="shell">
      <Reveal>
        <SectionHeading action={{ label: 'Ver todos', href: '/productos' }}>También te puede interesar</SectionHeading>
      </Reveal>
      <div class="grid grid-cols-2 gap-2 xs:gap-3 md:gap-4 desk:grid-cols-4">
        {related.map((item) => <ProductCard product={item} {...cardContext(catalog, item)} />)}
      </div>
    </div>
  </section>
)}
