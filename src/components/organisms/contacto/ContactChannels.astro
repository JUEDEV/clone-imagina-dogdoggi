---
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import Icon from '@/components/atoms/Icon.astro'
import { CONTACT_EMAIL, CONTACT_SCHEDULE, SOCIAL, WHATSAPP_DISPLAY, WHATSAPP_URL } from '@/data/site'

// Columna lateral de Contacto: WhatsApp, correo y horario, y redes.
const details = [
  { icon: 'mail', title: 'Correo electrónico', text: CONTACT_EMAIL },
  { icon: 'clock', title: 'Horario de atención', text: CONTACT_SCHEDULE },
] as const
---

<aside class="mt-3.5 grid gap-4 md:mt-0" aria-labelledby="other-channels-title">
  <div class="px-0.5 pt-1 pb-1.5">
    <Eyebrow class="mb-[13px] text-turquoise-dark">Otros canales</Eyebrow>
    <h2 id="other-channels-title" class="text-[29px] leading-[1.12] font-semibold tracking-[-0.02em] md:text-[31px]">Hablemos como prefieras</h2>
  </div>

  <article class="grid grid-cols-[auto_1fr] gap-4 rounded-[19px] bg-navy px-5 py-[23px] text-white md:p-[27px]">
    <div class="grid size-12 place-items-center rounded-full bg-turquoise text-navy">
      <Icon name="whatsapp" class="size-[25px]" />
    </div>
    <div>
      <span class="text-[10px] font-extrabold tracking-[0.12em] text-[#a7e9e6] uppercase">WhatsApp</span>
      <h3 class="mt-1 mb-2 text-[27px] font-medium tracking-[0.01em]">{WHATSAPP_DISPLAY}</h3>
      <p class="mb-[17px] text-[13px] text-[#d7e2ed]">Resolvemos tus dudas sobre productos y compras.</p>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-2 text-sm font-extrabold text-turquoise hover:text-white hover:underline"
      >
        Escribir por WhatsApp
        <Icon name="arrow-up-right" class="size-[18px]" />
      </a>
    </div>
  </article>

  <article class="rounded-[19px] border border-line bg-paper px-[25px] py-[9px]">
    {details.map((detail, i) => (
      <div class:list={['grid grid-cols-[34px_1fr] items-start gap-[13px] py-5', i > 0 && 'border-t border-line']}>
        <Icon name={detail.icon} strokeWidth={1.8} class="size-[25px] text-turquoise-dark" />
        <div>
          <h3 class="mb-[3px] font-sans text-sm font-extrabold">{detail.title}</h3>
          <p class="text-sm [overflow-wrap:anywhere] text-ink-soft">{detail.text}</p>
        </div>
      </div>
    ))}
  </article>

  <article class="rounded-[19px] border border-line bg-paper p-[25px]">
    <h3 class="mb-1 text-[21px] font-medium">Síguenos en redes</h3>
    <p class="mb-4 text-[13px] text-ink-soft">Consejos, novedades y el mundo Dog Doggi.</p>
    <div class="grid grid-cols-2 gap-2">
      {SOCIAL.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="grid min-h-12 grid-cols-[22px_1fr_auto] items-center gap-[7px] rounded-[9px] bg-[#eef7f7] px-2.5 py-2 text-xs font-extrabold transition-colors hover:bg-turquoise"
        >
          <Icon name={social.icon} class="size-[19px]" />
          <span>{social.label}</span>
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      ))}
    </div>
  </article>
</aside>
