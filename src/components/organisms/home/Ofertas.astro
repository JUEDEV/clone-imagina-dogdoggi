---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import Icon from '@/components/atoms/Icon.astro'
import Reveal from '@/components/atoms/Reveal.astro'
import ProductCard from '@/components/molecules/ProductCard.astro'
import { OFFERS } from '@/data/products'
---

<section id="ofertas" class="bg-peach py-16 md:py-24">
  <div class="shell">
    <Reveal class="mb-[34px] flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <Eyebrow class="text-[#a73d09]">Precios que sí mueven la cola</Eyebrow>
        <h2 class="mb-[7px] text-[32px] leading-[1.1] font-semibold tracking-[-0.02em] md:text-[clamp(32px,3vw,44px)]">
          Ofertas para tu peluquería
        </h2>
      </div>
      <ButtonLink href="#destacados" variant="outline" class="min-h-11 md:min-h-[50px]">
        Ver todas las ofertas
        <Icon name="arrow-right" class="size-[18px]" />
      </ButtonLink>
    </Reveal>
    <Reveal delay={120} class="grid grid-cols-2 gap-2 xs:gap-2.5 md:grid-cols-3 md:gap-4 desk:grid-cols-4">
      {OFFERS.map((product) => <ProductCard product={product} variant="compact" />)}
    </Reveal>
  </div>
</section>
