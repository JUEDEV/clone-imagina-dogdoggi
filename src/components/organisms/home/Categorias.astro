---
import Reveal from '@/components/atoms/Reveal.astro'
import CategoryCard from '@/components/molecules/CategoryCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { CATEGORIES } from '@/data/home'
---

<section class="bg-paper py-16 md:py-24">
  <div class="shell">
    <Reveal>
      <SectionHeading>Todo para tu peluquería</SectionHeading>
    </Reveal>
    <Reveal delay={120} class="grid grid-cols-2 gap-2.5 md:grid-cols-3 md:gap-4 desk:grid-cols-4">
      {CATEGORIES.map((category) => <CategoryCard category={category} />)}
    </Reveal>
  </div>
</section>
