---
import Icon from '@/components/atoms/Icon.astro'
import Reveal from '@/components/atoms/Reveal.astro'
import ProductCard from '@/components/molecules/ProductCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { cardContext, getCatalog, rootCategories } from '@/lib/catalog'

// Filtro sin JS: radios + :has(). La fila es un scroll-snap nativo (no hace
// falta Embla para deslizar); las flechas laterales son un <script> corto que
// desplaza la fila una tarjeta y se desactivan en los extremos.
// Las pestañas son las categorías raíz del catálogo; como cambian con el CMS,
// la regla que oculta las demás tarjetas se genera aquí (Tailwind no ve clases dinámicas).
const catalog = await getCatalog()
const featured = catalog.products.filter((p) => p.featured)
const products = (featured.length >= 4 ? featured : catalog.products).slice(0, 12)
const FILTERS = [
  { id: 'filtro-todos', label: 'Más vendidos', kind: '' },
  // Solo las raíces con productos en la vitrina (no pestañas vacías).
  ...rootCategories(catalog)
    .filter((c) => products.some((p) => cardContext(catalog, p).kind === c.slug))
    .map((c) => ({ id: `filtro-${c.slug}`, label: c.name, kind: c.slug })),
]
const filterCss = FILTERS.filter((f) => f.kind)
  .map((f) => `#destacados:has(#${f.id}:checked) [data-featured-track] [data-kind]:not([data-kind="${f.kind}"]){display:none}`)
  .join('')
---

<section id="destacados" class="bg-paper py-16 md:py-24">
  <div class="shell">
    <Reveal>
      <SectionHeading text="Selección profesional para comprar una y otra vez.">Los favoritos de los expertos</SectionHeading>
    </Reveal>

    <Reveal delay={120} class="group/filters">
      <fieldset class="scrollbar-none mb-7 flex min-w-0 gap-2 overflow-x-auto pb-[3px] md:overflow-visible md:pb-0">
        <legend class="sr-only">Filtrar productos</legend>
        {FILTERS.map((filter, i) => (
          <span class="relative shrink-0">
            <input type="radio" name="filtro-destacados" id={filter.id} class="peer sr-only" checked={i === 0} />
            <label
              for={filter.id}
              class="inline-flex min-h-11 cursor-pointer items-center rounded-3xl border border-line px-[18px] py-2 text-sm font-extrabold whitespace-nowrap transition-colors peer-checked:border-navy peer-checked:bg-navy peer-checked:text-white peer-focus-visible:outline-3 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-navy"
            >
              {filter.label}
            </label>
          </span>
        ))}
      </fieldset>

      <div class="relative">
        <div
          data-featured-track
          class="scrollbar-none grid auto-cols-[calc((100%-12px)/2)] md:cursor-grab grid-flow-col gap-3 overflow-x-auto px-0.5 pt-1 pb-5 snap-x snap-mandatory md:auto-cols-[calc((100%-48px)/4)] md:gap-4"
        >
          {products.map((product) => <ProductCard product={product} {...cardContext(catalog, product)} variant="compact" class="snap-start" />)}
        </div>
        {([
          { dir: -1, icon: 'chevron-left', label: 'Productos anteriores', side: '-left-3 desk:-left-6' },
          { dir: 1, icon: 'chevron-right', label: 'Productos siguientes', side: '-right-3 desk:-right-6' },
        ] as const).map((arrow) => (
          <button
            type="button"
            data-featured-arrow={arrow.dir}
            aria-label={arrow.label}
            class:list={[
              'absolute top-[calc(50%-10px)] z-10 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white text-navy shadow-[0_8px_24px_rgba(5,28,72,0.18)] transition-[background,color,opacity] duration-200 hover:bg-navy hover:text-white active:scale-95 disabled:pointer-events-none disabled:opacity-0 md:inline-grid',
              arrow.side,
            ]}
          >
            <Icon name={arrow.icon} class="size-6" />
          </button>
        ))}
      </div>
      <p class="mt-[5px] flex items-center justify-center gap-2 text-xs text-ink-soft md:hidden" aria-hidden="true">
        <Icon name="arrow-left" class="size-[15px]" /> Desliza para explorar <Icon name="arrow-right" class="size-[15px]" />
      </p>
    </Reveal>
  </div>
</section>

<style is:inline set:html={filterCss}></style>

<script>
  // Flechas de la fila de destacados: avanzan una tarjeta y se desactivan en
  // los extremos (o cuando el filtro deja menos tarjetas que el ancho).
  const track = document.querySelector<HTMLElement>('[data-featured-track]')
  const arrows = document.querySelectorAll<HTMLButtonElement>('[data-featured-arrow]')

  if (track) {
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2
      arrows.forEach((arrow) => {
        arrow.disabled = arrow.dataset.featuredArrow === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max
      })
    }

    arrows.forEach((arrow) => {
      arrow.addEventListener('click', () => {
        // El filtro oculta tarjetas con display:none: se mide la primera visible.
        const card = [...track.querySelectorAll<HTMLElement>('[data-kind]')].find((el) => el.offsetWidth > 0)
        const step = (card?.offsetWidth ?? track.clientWidth) + parseFloat(getComputedStyle(track).columnGap || '0')
        track.scrollBy({ left: Number(arrow.dataset.featuredArrow) * step, behavior: 'smooth' })
      })
    })

    // Arrastre con mouse (en táctil ya lo hace el scroll nativo). Mientras se
    // arrastra se apaga el snap; al soltar se encaja en la tarjeta más cercana.
    const stepSize = () => {
      const card = [...track.querySelectorAll<HTMLElement>('[data-kind]')].find((el) => el.offsetWidth > 0)
      return (card?.offsetWidth ?? track.clientWidth) + parseFloat(getComputedStyle(track).columnGap || '0')
    }
    let startX = 0
    let startScroll = 0
    let pressed = false
    let dragging = false

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return
      pressed = true
      dragging = false
      startX = event.clientX
      startScroll = track.scrollLeft
    })

    track.addEventListener('pointermove', (event) => {
      if (!pressed) return
      const dx = event.clientX - startX
      if (!dragging && Math.abs(dx) > 5) {
        dragging = true
        track.setPointerCapture(event.pointerId)
        track.style.scrollSnapType = 'none'
        track.style.cursor = 'grabbing'
        track.style.userSelect = 'none'
      }
      if (dragging) track.scrollLeft = startScroll - dx
    })

    const release = () => {
      if (!pressed) return
      pressed = false
      if (!dragging) return
      track.style.cursor = ''
      track.style.userSelect = ''
      const step = stepSize()
      track.scrollTo({ left: Math.round(track.scrollLeft / step) * step, behavior: 'smooth' })
      // Se devuelve el snap cuando termina la animación de encaje.
      const restore = () => (track.style.scrollSnapType = '')
      if ('onscrollend' in window) track.addEventListener('scrollend', restore, { once: true })
      else setTimeout(restore, 400)
    }
    track.addEventListener('pointerup', release)
    track.addEventListener('pointercancel', release)

    // Tras arrastrar, el clic al soltar no debe abrir el producto.
    track.addEventListener(
      'click',
      (event) => {
        if (!dragging) return
        event.preventDefault()
        event.stopPropagation()
        dragging = false
      },
      true,
    )
    // Evita el "arrastrar imagen/enlace" nativo del navegador.
    track.addEventListener('dragstart', (event) => event.preventDefault())

    track.addEventListener('scroll', update, { passive: true })
    document.querySelectorAll('input[name="filtro-destacados"]').forEach((input) =>
      input.addEventListener('change', () => {
        track.scrollTo({ left: 0 })
        requestAnimationFrame(update)
      }),
    )
    new ResizeObserver(update).observe(track)
  }
</script>
