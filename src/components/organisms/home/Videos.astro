---
import Icon from '@/components/atoms/Icon.astro'
import Reveal from '@/components/atoms/Reveal.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import VideoCard from '@/components/molecules/VideoCard.astro'
import { FEATURED_VIDEO, SIDE_VIDEOS } from '@/data/home'
import { YOUTUBE_URL } from '@/data/site'
---

<section class="py-16 md:py-24">
  <div class="shell">
    <Reveal>
      <SectionHeading text="Técnicas, consejos y demostraciones para tu día a día.">Míralo en acción</SectionHeading>
    </Reveal>
    <Reveal delay={120} class="grid gap-6 md:grid-cols-[1.6fr_1fr]">
      <VideoCard video={FEATURED_VIDEO} featured />
      <div class="flex flex-col gap-[15px]">
        {SIDE_VIDEOS.map((video) => <VideoCard video={video} />)}
        <a
          href={YOUTUBE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-[50px] items-center justify-center gap-2.5 rounded-xl border border-line font-extrabold transition-colors hover:border-navy"
        >
          <Icon name="youtube" /> Ver canal en YouTube <Icon name="arrow-up-right" class="size-[18px]" />
        </a>
      </div>
    </Reveal>
  </div>
</section>
