---
import Reveal from '@/components/atoms/Reveal.astro'
import ArticleCard from '@/components/molecules/ArticleCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { ARTICLES } from '@/data/blog'
---

<section id="blog" class="py-16 md:py-24">
  <div class="shell">
    <Reveal>
      <SectionHeading
        text="Tips, técnicas y productos para seguir creciendo como peluquero canino."
        action={{ label: 'Ver todos los artículos', href: '/blog' }}
      >
        Aprende con Dog Doggi
      </SectionHeading>
    </Reveal>
    <Reveal delay={120} class="grid gap-[22px] md:grid-cols-[1.2fr_1fr_1fr]">
      {ARTICLES.slice(0, 3).map((article) => <ArticleCard article={article} />)}
    </Reveal>
  </div>
</section>
