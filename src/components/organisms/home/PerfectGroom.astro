---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Icon from '@/components/atoms/Icon.astro'
import Reveal from '@/components/atoms/Reveal.astro'
import ProductCard from '@/components/molecules/ProductCard.astro'
import { PERFECT_BENEFITS } from '@/data/home'
import { COSMETICS } from '@/data/products'
---

<section id="perfect-groom" class="relative overflow-hidden bg-pg-deep py-[60px] text-white md:py-[90px]">
  <div aria-hidden="true" class="absolute -top-[300px] -left-[200px] size-[600px] rounded-full border border-white/15"></div>
  <div aria-hidden="true" class="absolute -right-[100px] -bottom-[200px] size-[350px] rounded-full border border-white/15"></div>

  <div class="shell relative z-[2] grid items-center gap-[35px] md:gap-[60px] desk:grid-cols-[0.85fr_1.65fr]">
    <Reveal class="md:grid md:grid-cols-2 md:gap-x-[30px] desk:block">
      <img
        src="/images/brand/perfect-groom-logo.png"
        alt="Perfect Groom — Nutrición de la raíz hasta las puntas"
        width="676"
        height="381"
        loading="lazy"
        class="mb-5 h-[115px] w-[200px] rounded-[18px] bg-white object-contain p-2 md:row-span-2 md:h-[150px] md:w-[250px]"
      />
      <div>
        <span class="mb-[15px] inline-block rounded-[5px] bg-yellow px-2.5 py-1 text-[11px] font-extrabold tracking-[0.1em] text-navy">
          SOLO EN DOG DOGGI
        </span>
        <h2 class="mb-[18px] text-[35px] leading-[1.06] font-semibold md:text-[clamp(35px,3.2vw,49px)]">
          Tu rutina profesional,<br />elevada a otro nivel.
        </h2>
        <p class="max-w-[450px] text-base text-[#f1faff] md:text-[17px]">
          Cosmética profesional exclusiva de Dog Doggi para acompañar cada etapa del cuidado del pelaje.
        </p>
      </div>
      <ul class="col-span-full my-[22px] grid list-none grid-cols-2 gap-2.5 p-0 md:my-[26px]">
        {PERFECT_BENEFITS.map((benefit) => (
          <li class="flex items-center gap-2 text-sm font-extrabold">
            <Icon name={benefit.icon} class="size-[19px] text-[#a9e9ff]" />
            {benefit.label}
          </li>
        ))}
      </ul>
      <ButtonLink href="#destacados" variant="outline-light" class="col-span-full w-full text-[13px] md:w-auto md:text-base">
        Ver toda la línea Perfect Groom
        <Icon name="arrow-right" class="size-[18px]" />
      </ButtonLink>
    </Reveal>

    <Reveal delay={120} class="grid grid-cols-2 gap-2 xs:gap-2.5 md:grid-cols-4 md:gap-4 desk:grid-cols-2">
      {COSMETICS.slice(0, 4).map((product) => <ProductCard product={product} variant="feature" />)}
    </Reveal>
  </div>
</section>
