---
import Icon from '@/components/atoms/Icon.astro'
import { WHATSAPP_URL } from '@/data/site'

// En móvil las tres frases comparten la misma celda y rotan con CSS
// (.utility-rotate en global.css); en escritorio se muestran en fila.
---

<div class="bg-navy text-xs font-bold text-[#f3fbfb] md:text-[13px]">
  <div class="utility-rotate shell grid min-h-8 place-items-center md:flex md:min-h-9 md:items-center md:justify-center md:gap-10">
    <span class="inline-flex items-center gap-[7px]"><Icon name="truck" class="size-[15px]" /> Envíos a todo el país</span>
    <span class="inline-flex items-center gap-[7px]"><Icon name="shield-check" class="size-[15px]" /> Pago seguro</span>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-[7px] p-1.5">
      <Icon name="message-circle" class="size-[15px]" /> Asesoría por WhatsApp
    </a>
  </div>
</div>
