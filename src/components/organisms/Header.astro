---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Icon from '@/components/atoms/Icon.astro'
import IconButton from '@/components/atoms/IconButton.astro'
import Logo from '@/components/atoms/Logo.astro'
import CartDrawer from '@/components/islands/CartDrawer'
import MegaMenu from '@/components/islands/MegaMenu'
import MobileMenu from '@/components/islands/MobileMenu'
import SearchBox from '@/components/islands/SearchBox'
import { NAV_AFTER, NAV_BEFORE, SHOP_MENU, WHATSAPP_URL, externalAttrs } from '@/data/site'

// Marca el ítem de la página actual (Nosotros, Contacto, Blog…).
const current = (href: string) => href !== '/' && !href.includes('#') && Astro.url.pathname.startsWith(href)
const navLinkClass = 'inline-flex min-h-11 items-center text-sm font-extrabold transition-colors hover:text-orange'
---

<header class="relative z-20 bg-paper shadow-[0_1px_0_rgba(5,28,72,0.09)]">
  <div class="bg-turquoise">
    <div
      class="shell grid min-h-[74px] grid-cols-[44px_1fr_auto_auto] items-center gap-2 md:min-h-[100px] md:grid-cols-[150px_1fr_auto] md:gap-[18px] desk:grid-cols-[190px_minmax(300px,1fr)_auto] desk:gap-9"
    >
      <MobileMenu
        client:media="(max-width: 767px)"
        before={NAV_BEFORE}
        shopLabel="Tienda"
        shop={SHOP_MENU}
        after={NAV_AFTER}
        note="Compra profesional, acompañada de verdad."
      >
        <ButtonLink slot="cta" href={WHATSAPP_URL} external class="w-full bg-[#087f5b] hover:bg-[#066b4c]">
          <Icon name="whatsapp" class="size-5" />
          Asesoría por WhatsApp
        </ButtonLink>
      </MobileMenu>

      <a href="/" aria-label="Dog Doggi, ir al inicio" class="justify-self-start py-2">
        <Logo class="h-[55px] w-[103px] xs:w-[116px] md:h-[72px] md:w-[145px] desk:w-44" />
      </a>

      <SearchBox
        client:visible
        placeholder="Busca por producto, marca, medida o referencia…"
        hints={['tijera', 'shampoo', 'cepillo']}
      />

      {/* TODO: cuenta y favoritos llegan con la fase de clientes (login de Strata). */}
      <div class="flex items-center md:gap-0 desk:gap-[7px]">
        <IconButton icon="user" label="Mi cuenta" class="hidden desk:inline-grid" />
        <CartDrawer client:idle />
      </div>
    </div>
  </div>

  <nav class="hidden border-t border-[#e7edef] md:block" aria-label="Navegación principal">
    <div class="shell flex min-h-[51px] items-center justify-center gap-9">
      {NAV_BEFORE.map((item) => (
        <a href={item.href} {...externalAttrs(item)} class:list={[navLinkClass, item.highlight && 'text-pg-ink']}>{item.label}</a>
      ))}
      <MegaMenu client:media="(min-width: 768px)" label="Tienda" items={SHOP_MENU}>
        <a
          slot="featured"
          href="/productos?marca=Perfect+Groom"
          class="flex flex-col justify-center rounded-2xl bg-[#e8f7fd] p-[22px] transition-colors hover:bg-[#d9f1fb]"
        >
          <img
            src="/images/brand/perfect-groom-logo.png"
            alt="Perfect Groom"
            width="676"
            height="381"
            loading="lazy"
            class="max-h-[120px] object-contain"
          />
          <span class="flex items-center justify-between text-sm font-extrabold">
            Cosmética profesional exclusiva
            <Icon name="arrow-right" class="size-[18px]" />
          </span>
        </a>
      </MegaMenu>
      {NAV_AFTER.map((item) => (
        <a
          href={item.href}
          {...externalAttrs(item)}
          aria-current={current(item.href) ? 'page' : undefined}
          class:list={[navLinkClass, 'aria-[current=page]:text-orange-dark aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8']}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
