---
import Reveal from '@/components/atoms/Reveal.astro'
import ArticleCard from '@/components/molecules/ArticleCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { ARTICLES } from '@/data/blog'

interface Props {
  /** Slug del artículo actual (se excluye). */
  current: string
}

const { current } = Astro.props
const related = ARTICLES.filter((a) => a.slug !== current).slice(0, 3)
---

{related.length > 0 && (
  <section class="bg-mint py-16 md:py-24">
    <div class="shell">
      <Reveal>
        <SectionHeading action={{ label: 'Ver todos los artículos', href: '/blog' }}>Sigue aprendiendo</SectionHeading>
      </Reveal>
      <Reveal delay={120} class="grid gap-[22px] md:grid-cols-2 desk:grid-cols-3">
        {related.map((article) => <ArticleCard article={article} />)}
      </Reveal>
    </div>
  </section>
)}
