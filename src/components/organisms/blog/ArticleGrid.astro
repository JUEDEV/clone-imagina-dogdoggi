---
import Reveal from '@/components/atoms/Reveal.astro'
import ArticleCard from '@/components/molecules/ArticleCard.astro'
import { ARTICLES } from '@/data/blog'
---

<section class="py-16 md:py-24">
  <Reveal class="shell grid gap-[22px] md:grid-cols-2 desk:grid-cols-3">
    {ARTICLES.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
  </Reveal>
</section>
