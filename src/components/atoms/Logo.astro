---
// Logo de Dog Doggi: PNG/WebP transparente con contorno blanco, funciona
// sobre turquesa (header), navy (footer) y blanco (menú móvil).
interface Props {
  class?: string
}

const { class: className = 'h-[72px] w-44' } = Astro.props
---

<img src="/images/brand/dog-doggi-logo.webp" alt="Dog Doggi" width="600" height="245" class:list={['object-contain', className]} />
