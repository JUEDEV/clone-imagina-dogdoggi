---
import Layout from '@/layouts/Layout.astro'
import ProductDetail from '@/components/organisms/producto/ProductDetail.astro'
import RelatedProducts from '@/components/organisms/producto/RelatedProducts.astro'
import { categoryPath, findCategoryById, findProductBySlug, getCatalog } from '@/lib/catalog'
import { breadcrumbJsonLd, buildTitle, SITE_NAME, type Crumb } from '@/lib/seo'

// Ficha de producto. SSR: precio y stock siempre al día con Strata (caché 60 s).
export const prerender = false

const catalog = await getCatalog()
const product = findProductBySlug(catalog, Astro.params.slug ?? '')
if (!product) return new Response(null, { status: 404 })

const category = findCategoryById(catalog, product.categoryId)
const crumbs: Crumb[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/productos' },
  ...categoryPath(catalog, category).map((c) => ({ label: c.name, href: `/categorias/${c.slug}` })),
  { label: product.name },
]

const plain = (product.description ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
const description = product.metaDescription ?? (plain.slice(0, 155) || `${product.name} en ${SITE_NAME}.`)
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path)
const pageUrl = abs(Astro.url.pathname)
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: plain.slice(0, 500) || undefined,
  image: product.images.map(abs),
  sku: product.sku,
  category: category?.name,
  brand: { '@type': 'Brand', name: product.brand ?? SITE_NAME },
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    priceCurrency: 'COP',
    price: product.price,
    availability: product.stock !== null && product.stock <= 0 ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
}
---

<Layout
  title={buildTitle(product.metaTitle ?? product.name)}
  description={description}
  image={product.image}
  preloadImage={product.images[0]}
  type="product"
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site, Astro.url.pathname), productJsonLd]}
>
  <main id="main-content">
    <ProductDetail product={product} category={category} crumbs={crumbs} url={pageUrl} />
    <RelatedProducts catalog={catalog} product={product} />
  </main>
</Layout>
